@{
    ViewData["Title"] = "Home Page";
}

<div class="hero text-center">
    <h1 class="display-5 fw-bold></h1>
    <p class=" lead">Delivering swift, effective disaster relief across South Africa and beyond</p>
        <a class=" btn btn-light btn-lg me-2" asp-controller="Donate" asp-action="Index">donate Now</a>
        <a class="btn btn-outline-light btn-lg" asp-controller="Volunteer" asp-action="Index"> Become a Volunteer </a>
            </div>
<div class="row text-center g-4">
    <div class="col-md-4">
        <div class="card card-module p-4 h-100">
            <h4>Rapid Response</h4>
            <p>Our teams mobilise within hours of a disaster to deliver food,water and medical aid</p>

        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-module p-4 h-100">
            <h4>Volunteer Network</h4>
            
            <p>Thousands of registered volunteers ready to be deployed where they're needed most</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-module p-4 h-100">
            <h4>Transparent Donations</h4>
            <p>Every donation is tracked and tied directly to the relief projects it supports</p>
        </div>
    </div>

</div>
