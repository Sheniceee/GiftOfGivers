@model GiftOfGivers.Models.Volunteer
@{
    ViewData["Title"] = "Volunteer";
}
<h2>Register as a volunteer</h2>
<p class="text-muted"> Tell us about yourself so we can reach you when disaster relief teams are needed</p>
 <form asp-action="Index" method="post" class="col-md-6">
     <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FullName" class="form-label">FullName</label>
        <input asp-for="FullName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Skills" class="form-label">Skills</label>
        <input asp-for="Skills" class="form-control" />

    </div>

    <div class="mb-3">
        <label asp-for="Availability" class="form-label">Availability</label>
        <input asp-for="Availability" class="form-control" placeholder="e.g. Weekends, Evenings, Full-time" />
    </div>
    <button type="submit" class="btn btn-primary-brand">Submit</button>
</form>

